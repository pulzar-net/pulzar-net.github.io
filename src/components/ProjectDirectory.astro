---
/*
 * Every public project, by area, from @pulzr/docs-theme's projects.mjs.
 * A project with docs links them; the rest link their repository, whose
 * README is the documentation.
 */
import { Icon } from '@astrojs/starlight/components';
import { projects, areas } from '@pulzr/docs-theme/projects';
const sections = areas
	.map((area) => ({ ...area, projects: projects.filter((p) => p.area === area.id) }))
	.filter((a) => a.projects.length > 0);
---

<div class="pz-directory not-content">
	{sections.map((area) => (
		<section aria-labelledby={`area-${area.id}`}>
			<h2 id={`area-${area.id}`} class="pz-display">{area.name}</h2>
			{area.description && <p class="area-desc">{area.description}</p>}
			<ul>
				{area.projects.map((p) => (
					<li class="card">
						<a class="name" href={p.docs ?? p.repo}>{p.name}</a>
						<p>{p.description}</p>
						<div class="links">
							{p.docs && (
								<a href={p.docs}>
									<Icon name="open-book" size="0.95rem" />
									Docs
								</a>
							)}
							<a href={p.repo}>
								<Icon name="github" size="0.95rem" />
								GitHub
							</a>
						</div>
					</li>
				))}
			</ul>
		</section>
	))}
</div>

<style>
	.pz-directory {
		display: grid;
		gap: 2.5rem;
		margin: 1rem 0 3rem;
	}
	h2 {
		margin: 0;
		font-size: var(--sl-text-xl);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.area-desc {
		margin: 0.3rem 0 0;
		color: var(--pz-text-secondary);
		font-size: var(--sl-text-sm);
	}
	ul {
		list-style: none;
		margin: 0.9rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 0.9rem;
	}
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1rem 1.1rem;
		background: var(--pz-card-bg);
		border: 1px solid var(--pz-card-border);
		border-radius: var(--pz-radius-lg);
		box-shadow: var(--pz-card-shadow);
		transition: box-shadow 0.15s, border-color 0.15s;
	}
	.card:hover {
		box-shadow: var(--pz-card-shadow-hover);
		border-color: color-mix(in srgb, var(--sl-color-accent) 35%, var(--pz-card-border));
	}
	.name {
		font-family: var(--pz-font-display);
		font-weight: 600;
		font-size: var(--sl-text-base);
		color: var(--sl-color-white);
		text-decoration: none;
	}
	/* The whole card opens the project's name link. */
	.name::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	.name:focus-visible {
		outline: none;
	}
	.card:has(.name:focus-visible) {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.card p {
		margin: 0;
		flex: 1;
		font-size: var(--sl-text-sm);
		color: var(--pz-text-secondary);
		line-height: 1.45;
	}
	.links {
		display: flex;
		gap: 1rem;
		margin-top: 0.4rem;
	}
	.links a {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--sl-color-accent);
	}
</style>
